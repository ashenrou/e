<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Studio</title>
<style>
  :root{
    --bg:#eef1f6;
    --bg-soft:#f5f5f7;
    --ink:#1d1d1f;
    --ink-soft:#6e6e73;
    --blue:#0071e3;
    --blue-dark:#0059b3;
    --line:rgba(0,0,0,0.08);
    --radius:18px;
    --shadow:0 10px 30px rgba(0,0,0,0.08);
    --glass-bg:rgba(255,255,255,0.38);
    --glass-bg-strong:rgba(255,255,255,0.55);
    --glass-border:rgba(255,255,255,0.65);
    --glass-shadow:0 8px 32px rgba(31,42,68,0.14), inset 0 1px 0 rgba(255,255,255,0.75), inset 0 -1px 0 rgba(255,255,255,0.15);
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Helvetica Neue",Arial,sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{height:100%;}
  body{
    background:var(--bg);
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
    position:relative;
  }
  a{color:inherit;text-decoration:none;}
  button{font-family:inherit;cursor:pointer;border:none;}

  /* ---------- AMBIENT BACKDROP (for the glass to refract) ---------- */
  .backdrop{
    position:fixed;inset:0;z-index:-1;overflow:hidden;
  }
  .backdrop span{
    position:absolute;border-radius:50%;filter:blur(70px);opacity:.55;
    animation:drift 22s ease-in-out infinite alternate;
  }
  .backdrop span:nth-child(1){width:520px;height:520px;top:-160px;left:-120px;background:radial-gradient(circle,#7fb8ff,#0071e3 70%);}
  .backdrop span:nth-child(2){width:460px;height:460px;top:20%;right:-140px;background:radial-gradient(circle,#c9a4ff,#7b61ff 70%);animation-delay:-6s;}
  .backdrop span:nth-child(3){width:420px;height:420px;bottom:-140px;left:18%;background:radial-gradient(circle,#ffb6c9,#ff6b9d 70%);animation-delay:-12s;}
  .backdrop span:nth-child(4){width:380px;height:380px;bottom:5%;right:12%;background:radial-gradient(circle,#9df2d6,#00c896 70%);animation-delay:-3s;}
  @keyframes drift{
    0%{transform:translate(0,0) scale(1);}
    100%{transform:translate(40px,-30px) scale(1.08);}
  }

  /* ---------- NAV (liquid glass pill) ---------- */
  .nav{
    position:fixed;top:14px;left:50%;
    width:auto;height:auto;
    display:flex;align-items:center;justify-content:center;
    z-index:1000;
    transform:translate(-50%,-140%);
    transition:transform .55s cubic-bezier(.34,1.4,.4,1);
  }
  .nav.show{transform:translate(-50%,0);}
  .nav-inner{
    width:auto;max-width:none;
    display:flex;align-items:center;gap:8px;
    padding:8px 10px 8px 20px;
    background:var(--glass-bg-strong);
    backdrop-filter:blur(28px) saturate(200%);
    -webkit-backdrop-filter:blur(28px) saturate(200%);
    border:1px solid var(--glass-border);
    border-radius:980px;
    box-shadow:var(--glass-shadow);
  }
  .nav-logo{font-weight:600;font-size:14px;letter-spacing:.2px;margin-right:10px;}
  .nav-links{display:flex;gap:4px;list-style:none;position:relative;}
  .nav-links button{
    background:none;color:var(--ink-soft);font-size:12.5px;font-weight:500;
    letter-spacing:.2px;padding:8px 16px;border-radius:980px;position:relative;
    transition:color .25s, background .25s;
  }
  .nav-links button.active{color:#fff;background:linear-gradient(155deg,#0071e3,#3a9bff);box-shadow:0 4px 14px rgba(0,113,227,.4), inset 0 1px 0 rgba(255,255,255,.5);}
  .nav-links button:hover:not(.active){color:var(--ink);background:rgba(255,255,255,.5);}
  .nav-logout{
    background:rgba(255,255,255,.5);color:var(--ink-soft);font-size:12px;font-weight:500;
    padding:8px 16px;border-radius:980px;margin-left:6px;transition:color .25s, background .25s;
  }
  .nav-logout:hover{color:var(--ink);background:rgba(255,255,255,.75);}

  /* ---------- VIEWS ---------- */
  .view{
    display:none;
    min-height:100vh;
    animation:fadein .6s ease;
  }
  .view.active{display:block;}
  @keyframes fadein{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}

  /* ---------- LOGIN ---------- */
  #view-login{
    display:flex;align-items:center;justify-content:center;
    min-height:100vh;
    padding:24px;
  }
  .login-card{
    width:100%;max-width:360px;
    background:var(--glass-bg);
    backdrop-filter:blur(30px) saturate(190%);
    -webkit-backdrop-filter:blur(30px) saturate(190%);
    border-radius:28px;
    box-shadow:var(--glass-shadow);
    padding:44px 36px 36px;
    border:1px solid var(--glass-border);
    position:relative;
    overflow:hidden;
  }
  .login-card::before{
    content:"";position:absolute;top:0;left:0;right:0;height:1px;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.9),transparent);
  }
  .login-mark{
    width:44px;height:44px;border-radius:14px;
    background:linear-gradient(150deg,#0071e3,#42a5ff);
    display:flex;align-items:center;justify-content:center;
    margin:0 auto 22px;
    color:#fff;font-weight:700;font-size:18px;
    box-shadow:0 6px 16px rgba(0,113,227,.4), inset 0 1px 0 rgba(255,255,255,.5);
  }
  .login-card h1{
    font-size:22px;font-weight:600;text-align:center;margin-bottom:6px;
  }
  .login-card p.sub{
    text-align:center;color:var(--ink-soft);font-size:13px;margin-bottom:28px;
  }
  .field{margin-bottom:14px;}
  .field label{
    display:block;font-size:12px;color:var(--ink-soft);margin-bottom:6px;font-weight:500;
  }
  .field input{
    width:100%;padding:12px 14px;border-radius:12px;
    border:1px solid rgba(255,255,255,.6);background:rgba(255,255,255,.45);
    font-size:14px;color:var(--ink);outline:none;
    backdrop-filter:blur(6px);
    transition:border-color .2s, background .2s;
  }
  .field input:focus{border-color:var(--blue);background:rgba(255,255,255,.85);}
  .btn-primary{
    width:100%;padding:13px;border-radius:980px;
    background:linear-gradient(150deg,#0071e3,#3a9bff);color:#fff;font-size:14.5px;font-weight:600;
    margin-top:8px;transition:transform .15s, box-shadow .2s;
    box-shadow:0 8px 20px rgba(0,113,227,.35), inset 0 1px 0 rgba(255,255,255,.5);
  }
  .btn-primary:hover{transform:translateY(-1px);box-shadow:0 10px 26px rgba(0,113,227,.45), inset 0 1px 0 rgba(255,255,255,.5);}
  .btn-primary:active{transform:scale(.98);}
  .login-foot{
    text-align:center;margin-top:20px;font-size:12.5px;color:var(--ink-soft);
  }
  .login-foot a{color:var(--blue);font-weight:500;}
  .err{
    display:none;background:rgba(255,242,241,.85);color:#c0392b;font-size:12px;
    border-radius:10px;padding:9px 12px;margin-bottom:14px;border:1px solid rgba(192,57,43,.15);
  }

  /* ---------- HOME ---------- */
  .hero{
    min-height:100vh;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    text-align:center;padding:140px 24px 80px;
  }
  .hero .eyebrow{
    font-size:13px;font-weight:600;color:var(--blue);letter-spacing:.4px;margin-bottom:14px;
  }
  .hero h1{
    font-size:clamp(40px,7vw,76px);
    font-weight:700;letter-spacing:-.03em;line-height:1.05;
    max-width:820px;
  }
  .hero h1 span{
    background:linear-gradient(90deg,#0071e3,#42a5ff);
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .hero p.lede{
    max-width:560px;margin:22px auto 36px;
    font-size:19px;line-height:1.5;color:var(--ink-soft);font-weight:400;
  }
  .hero-actions{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;}
  .btn{
    padding:13px 26px;border-radius:980px;font-size:15px;font-weight:600;
    transition:transform .15s, box-shadow .2s;
    border:1px solid var(--glass-border);
  }
  .btn-fill{
    background:linear-gradient(150deg,#1d1d1f,#3a3a3c);color:#fff;border:none;
    box-shadow:0 8px 20px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.25);
  }
  .btn-fill:hover{transform:translateY(-1px);box-shadow:0 10px 26px rgba(0,0,0,.3), inset 0 1px 0 rgba(255,255,255,.25);}
  .btn-ghost{
    background:var(--glass-bg);color:var(--ink);
    backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);
    box-shadow:var(--glass-shadow);
  }
  .btn-ghost:hover{transform:translateY(-1px);background:var(--glass-bg-strong);}

  .section-title{
    text-align:center;max-width:640px;margin:0 auto 50px;
  }
  .section-title .eyebrow{font-size:13px;font-weight:600;color:var(--blue);margin-bottom:10px;}
  .section-title h2{font-size:clamp(30px,4vw,44px);font-weight:700;letter-spacing:-.02em;}
  .section-title p{color:var(--ink-soft);font-size:16px;margin-top:12px;line-height:1.5;}

  .strip{padding:90px 24px;max-width:1080px;margin:0 auto;}
  .strip.alt{background:var(--glass-bg);border-radius:32px;max-width:1160px;}

  .feature-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:20px;max-width:1000px;margin:0 auto;
  }
  .feature-card{
    background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:22px;padding:30px 26px;
    backdrop-filter:blur(24px) saturate(180%);-webkit-backdrop-filter:blur(24px) saturate(180%);
    box-shadow:var(--glass-shadow);
    transition:transform .25s, box-shadow .25s, background .25s;
    position:relative;overflow:hidden;
  }
  .feature-card::before{
    content:"";position:absolute;top:0;left:0;right:0;height:1px;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.9),transparent);
  }
  .feature-card:hover{transform:translateY(-4px);background:var(--glass-bg-strong);}
  .feature-icon{
    width:42px;height:42px;border-radius:13px;background:rgba(255,255,255,.55);
    display:flex;align-items:center;justify-content:center;margin-bottom:16px;font-size:19px;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.8);
  }
  .feature-card h3{font-size:17px;font-weight:600;margin-bottom:8px;}
  .feature-card p{font-size:14px;color:var(--ink-soft);line-height:1.5;}

  /* ---------- GALLERY ---------- */
  .gallery-wrap{padding:150px 24px 100px;max-width:1080px;margin:0 auto;}
  .gallery-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:16px;
  }
  .gallery-item{
    aspect-ratio:1/1;border-radius:24px;position:relative;overflow:hidden;
    display:flex;align-items:flex-end;padding:18px;
    color:#fff;font-weight:600;font-size:14px;
    box-shadow:0 12px 30px rgba(0,0,0,.16), inset 0 1px 0 rgba(255,255,255,.35);
    border:1px solid rgba(255,255,255,.35);
    transition:transform .3s;
  }
  .gallery-item:hover{transform:scale(1.02) translateY(-2px);}
  .gallery-item span{position:relative;z-index:1;}
  .gallery-item::after{
    content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.25) 0%, rgba(0,0,0,0) 35%, rgba(0,0,0,.5) 100%);
  }
  .g1{background:linear-gradient(135deg,#0071e3,#42a5ff);}
  .g2{background:linear-gradient(135deg,#7b61ff,#c084fc);}
  .g3{background:linear-gradient(135deg,#ff6b6b,#ffa26b);}
  .g4{background:linear-gradient(135deg,#00c896,#5eead4);}
  .g5{background:linear-gradient(135deg,#1d1d1f,#4a4a4d);}
  .g6{background:linear-gradient(135deg,#ff9de2,#ff6bb3);}

  /* ---------- ABOUT ---------- */
  .about-wrap{padding:150px 24px 100px;max-width:1000px;margin:0 auto;}
  .team-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:22px;max-width:900px;margin:0 auto;
  }
  .team-card{
    text-align:center;background:var(--glass-bg);border:1px solid var(--glass-border);
    border-radius:24px;padding:34px 20px;
    backdrop-filter:blur(24px) saturate(180%);-webkit-backdrop-filter:blur(24px) saturate(180%);
    box-shadow:var(--glass-shadow);
    transition:transform .25s, background .25s;
    position:relative;overflow:hidden;
  }
  .team-card::before{
    content:"";position:absolute;top:0;left:0;right:0;height:1px;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.9),transparent);
  }
  .team-card:hover{transform:translateY(-4px);background:var(--glass-bg-strong);}
  .avatar{
    width:88px;height:88px;border-radius:50%;margin:0 auto 18px;
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-weight:600;font-size:26px;
    box-shadow:0 8px 20px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.5);
  }
  .a1{background:linear-gradient(145deg,#0071e3,#42a5ff);}
  .a2{background:linear-gradient(145deg,#7b61ff,#c084fc);}
  .a3{background:linear-gradient(145deg,#ff6b6b,#ffa26b);}
  .team-card h3{font-size:16.5px;font-weight:600;margin-bottom:4px;}
  .team-card .role{font-size:13px;color:var(--blue);font-weight:500;margin-bottom:10px;}
  .team-card p{font-size:13.5px;color:var(--ink-soft);line-height:1.5;}

  footer{
    text-align:center;padding:36px 24px;color:var(--ink-soft);font-size:12.5px;
  }

  @media (max-width:720px){
    .feature-grid,.gallery-grid,.team-grid{grid-template-columns:repeat(2,1fr);}
    .nav-links{gap:20px;}
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:.01ms !important;transition-duration:.01ms !important;}
  }
</style>
</head>
<body>

  <div class="backdrop"><span></span><span></span><span></span><span></span></div>

  <!-- NAV (hidden until logged in) -->
  <nav class="nav" id="nav">
    <div class="nav-inner">
      <div class="nav-logo">studio</div>
      <ul class="nav-links">
        <li><button data-go="home" class="active">Home</button></li>
        <li><button data-go="gallery">Gallery</button></li>
        <li><button data-go="about">About Us</button></li>
      </ul>
      <button class="nav-logout" id="logoutBtn">Sign out</button>
    </div>
  </nav>

  <!-- 1) LOGIN PAGE -->
  <section class="view active" id="view-login">
    <div class="login-card">
      <div class="login-mark">S</div>
      <h1>Sign in</h1>
      <p class="sub">Welcome back. Enter your details to continue.</p>
      <div class="err" id="loginErr">Enter an email and password to continue.</div>
      <form id="loginForm">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" placeholder="you@example.com">
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" placeholder="••••••••">
        </div>
        <button type="submit" class="btn-primary">Sign In</button>
      </form>
      <div class="login-foot">Just exploring? <a href="#" id="guestLink">Continue as guest</a></div>
    </div>
  </section>

  <!-- 2) HOME PAGE -->
  <section class="view" id="view-home">
    <div class="hero">
      <div class="eyebrow">WELCOME</div>
      <h1>Beautifully simple, <span>thoughtfully made.</span></h1>
      <p class="lede">A clean, focused space to showcase your work and introduce the people behind it — designed with clarity and care.</p>
      <div class="hero-actions">
        <button class="btn btn-fill" data-go="gallery">View Gallery</button>
        <button class="btn btn-ghost" data-go="about">Meet the Creators</button>
      </div>
    </div>

    <div class="strip">
      <div class="section-title">
        <div class="eyebrow">WHY IT WORKS</div>
        <h2>Everything in its place</h2>
        <p>Three ideas guide every decision on this site — clarity, warmth, and craft.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card">
          <div class="feature-icon">◎</div>
          <h3>Clarity</h3>
          <p>No clutter, no noise — just the content that matters, presented simply.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">✦</div>
          <h3>Craft</h3>
          <p>Every detail, from spacing to motion, is considered on purpose.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">◐</div>
          <h3>Warmth</h3>
          <p>A friendly, human tone that still feels polished and confident.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3) GALLERY -->
  <section class="view" id="view-gallery">
    <div class="gallery-wrap">
      <div class="section-title">
        <div class="eyebrow">GALLERY</div>
        <h2>A look at the work</h2>
        <p>A snapshot of moments and pieces worth sharing. Swap these placeholders for your own images.</p>
      </div>
      <div class="gallery-grid">
        <div class="gallery-item g1"><span>Piece 01</span></div>
        <div class="gallery-item g2"><span>Piece 02</span></div>
        <div class="gallery-item g3"><span>Piece 03</span></div>
        <div class="gallery-item g4"><span>Piece 04</span></div>
        <div class="gallery-item g5"><span>Piece 05</span></div>
        <div class="gallery-item g6"><span>Piece 06</span></div>
      </div>
    </div>
  </section>

  <!-- 4) ABOUT US / THE CREATORS -->
  <section class="view" id="view-about">
    <div class="about-wrap">
      <div class="section-title">
        <div class="eyebrow">ABOUT US</div>
        <h2>The Creators</h2>
        <p>The people who designed and built this space, and keep it running.</p>
      </div>
      <div class="team-grid">
        <div class="team-card">
          <div class="avatar a1">A</div>
          <h3>Creator One</h3>
          <div class="role">Design</div>
          <p>Shapes the look and feel of everything you see here.</p>
        </div>
        <div class="team-card">
          <div class="avatar a2">B</div>
          <h3>Creator Two</h3>
          <div class="role">Development</div>
          <p>Builds and maintains the site behind the scenes.</p>
        </div>
        <div class="team-card">
          <div class="avatar a3">C</div>
          <h3>Creator Three</h3>
          <div class="role">Content</div>
          <p>Writes and curates everything you read on the site.</p>
        </div>
      </div>
    </div>
    <footer>© 2026 Studio. All rights reserved.</footer>
  </section>

<script>
  const nav = document.getElementById('nav');
  const views = {
    login: document.getElementById('view-login'),
    home: document.getElementById('view-home'),
    gallery: document.getElementById('view-gallery'),
    about: document.getElementById('view-about'),
  };
  const navButtons = document.querySelectorAll('.nav-links button');

  function goTo(name){
    Object.values(views).forEach(v => v.classList.remove('active'));
    views[name].classList.add('active');
    window.scrollTo({top:0, behavior:'instant' in window ? 'instant' : 'auto'});
    if(name !== 'login'){
      nav.classList.add('show');
      navButtons.forEach(b => b.classList.toggle('active', b.dataset.go === name));
    } else {
      nav.classList.remove('show');
    }
  }

  document.querySelectorAll('[data-go]').forEach(el=>{
    el.addEventListener('click', ()=> goTo(el.dataset.go));
  });

  document.getElementById('loginForm').addEventListener('submit', function(e){
    e.preventDefault();
    const email = document.getElementById('email').value.trim();
    const pass = document.getElementById('password').value.trim();
    const err = document.getElementById('loginErr');
    if(!email || !pass){
      err.style.display = 'block';
      return;
    }
    err.style.display = 'none';
    goTo('home');
  });

  document.getElementById('guestLink').addEventListener('click', function(e){
    e.preventDefault();
    goTo('home');
  });

  document.getElementById('logoutBtn').addEventListener('click', function(){
    document.getElementById('email').value = '';
    document.getElementById('password').value = '';
    goTo('login');
  });
</script>
</body>
</html>
