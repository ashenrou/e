<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WANDERLUST — Negros Oriental</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Syne:wght@700;800&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-color: #ffffff;
      --text-color: #000000;
      --border-color: #000000;
      --card-bg: #f8f8f8;
      --accent-hover: #000000;
      --accent-text-hover: #ffffff;
    }

    [data-theme="dark"] {
      --bg-color: #0a0a0a;
      --text-color: #ffffff;
      --border-color: #ffffff;
      --card-bg: #141414;
      --accent-hover: #ffffff;
      --accent-text-hover: #000000;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-color);
      color: var(--text-color);
      font-family: 'Inter', sans-serif;
      transition: background-color 0.3s ease, color 0.3s ease, filter 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
    }

    body.page-exit {
      filter: blur(12px) brightness(1.1);
      transform: scale(0.98);
      opacity: 0;
    }

    body.page-enter {
      animation: motionBlurIn 0.4s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }

    @keyframes motionBlurIn {
      0% { filter: blur(15px); transform: scale(1.02); opacity: 0; }
      100% { filter: blur(0px); transform: scale(1); opacity: 1; }
    }

    header {
      width: 100%;
      padding: 25px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--border-color);
    }

    .logo {
      font-family: 'Playfair Display', serif;
      font-size: 2.2rem;
      font-weight: 900;
      text-transform: uppercase;
      color: var(--text-color);
      text-decoration: none;
    }

    nav { display: flex; align-items: center; gap: 20px; }

    .nav-btn {
      text-decoration: none;
      color: var(--text-color);
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      padding: 8px 16px;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }

    .nav-btn:hover, .nav-btn.active {
      border-color: var(--border-color);
      background: var(--accent-hover);
      color: var(--accent-text-hover);
    }

    .theme-toggle-btn {
      background: none;
      border: 1px solid var(--border-color);
      color: var(--text-color);
      padding: 8px 16px;
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 0.8rem;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .theme-toggle-btn:hover {
      background: var(--accent-hover);
      color: var(--accent-text-hover);
    }

    main {
      flex: 1;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      padding: 50px 20px;
    }

    .hero {
      text-align: center;
      border-bottom: 2px solid var(--border-color);
      padding-bottom: 40px;
      margin-bottom: 50px;
    }

    .hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: 4rem;
      font-weight: 900;
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .hero p {
      font-family: 'Syne', sans-serif;
      font-size: 1rem;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* Games Grid */
    .games-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 30px;
    }

    .game-card {
      background: var(--card-bg);
      border: 2px solid var(--border-color);
      padding: 25px;
      box-shadow: 6px 6px 0px var(--border-color);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .game-card h2 {
      font-family: 'Playfair Display', serif;
      font-size: 1.8rem;
      font-weight: 900;
      margin-bottom: 10px;
      text-transform: uppercase;
    }

    .game-card p {
      font-size: 0.9rem;
      line-height: 1.4;
      opacity: 0.85;
      margin-bottom: 20px;
    }

    .game-box {
      border: 2px solid var(--border-color);
      background: var(--bg-color);
      padding: 15px;
      text-align: center;
      min-height: 180px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 10px;
    }

    .action-btn {
      background: var(--bg-color);
      border: 2px solid var(--border-color);
      color: var(--text-color);
      padding: 10px 20px;
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 0.8rem;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .action-btn:hover {
      background: var(--accent-hover);
      color: var(--accent-text-hover);
    }

    /* Game 1 Canvas */
    canvas {
      border: 1px solid var(--border-color);
      background: var(--card-bg);
    }

    @media (max-width: 768px) {
      header { flex-direction: column; gap: 15px; padding: 20px; }
      .hero h1 { font-size: 2.5rem; }
    }
  </style>
</head>
<body>

  <header>
    <a href="index.html" class="logo">Wanderlust</a>
    <nav>
      <a href="index.html" class="nav-btn active">Home</a>
      <a href="gallery.html" class="nav-btn">Gallery</a>
      <a href="about.html" class="nav-btn">About Us</a>
      <a href="login.html" class="nav-btn">Login</a>
      <button class="theme-toggle-btn" id="theme-btn" onclick="toggleTheme()">Dark Mode</button>
    </nav>
  </header>

  <main>
    <div class="hero">
      <h1>Negros Oriental Arcade</h1>
      <p>INTERACTIVE LOCAL EXPERIENCES & ARCADE ESSENTIALS</p>
    </div>

    <div class="games-grid">
      <!-- Game 1: Dumaguete Silvanas Catcher -->
      <div class="game-card">
        <div>
          <h2>Boulevard Catcher</h2>
          <p>Catch Dumaguete's iconic street snacks falling along Rizal Boulevard!</p>
        </div>
        <div class="game-box">
          <canvas id="catcherCanvas" width="220" height="120"></canvas>
          <div style="display: flex; gap: 10px; width: 100%; justify-content: center;">
            <button class="action-btn" onclick="moveCatcher(-20)">◀ Left</button>
            <button class="action-btn" onclick="moveCatcher(20)">Right ▶</button>
          </div>
        </div>
      </div>

      <!-- Game 2: Apo Turtle Swim -->
      <div class="game-card">
        <div>
          <h2>Apo Turtle Swim</h2>
          <p>Guide the sea turtle through Apo Island's marine sanctuary currents.</p>
        </div>
        <div class="game-box">
          <div id="turtle-score" style="font-family:'Syne',sans-serif; font-weight:800;">TURTLE DEPTH: 0m</div>
          <button class="action-btn" onclick="swimTurtle()">Paddle Turtle 🐢</button>
        </div>
      </div>

      <!-- Game 3: Negros Oriental Trivia -->
      <div class="game-card">
        <div>
          <h2>Province Quiz</h2>
          <p>Test your knowledge about the Land of Gentle People.</p>
        </div>
        <div class="game-box">
          <div id="trivia-q" style="font-size: 0.85rem; font-weight: 600;">Click start to test your knowledge!</div>
          <div id="trivia-opts" style="display: flex; flex-direction: column; gap: 5px; width: 100%;"></div>
          <button class="action-btn" id="trivia-btn" onclick="nextTrivia()">Start Quiz</button>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Game 1: Boulevard Catcher Logic
    const canvas = document.getElementById('catcherCanvas');
    const ctx = canvas.getContext('2d');
    let basketX = 90;
    let itemX = Math.random() * 200;
    let itemY = 0;
    let score1 = 0;

    function drawCatcher() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      // Draw falling food item (Silvanas)
      ctx.fillStyle = '#000';
      if (document.documentElement.getAttribute('data-theme') === 'dark') ctx.fillStyle = '#fff';
      ctx.fillRect(itemX, itemY, 12, 12);
      
      // Draw Basket
      ctx.fillRect(basketX, 105, 40, 10);
      
      // Update item position
      itemY += 2;
      if (itemY > 105) {
        if (itemX > basketX - 10 && itemX < basketX + 40) score1++;
        itemY = 0;
        itemX = Math.random() * 200;
      }
      
      // Score text
      ctx.font = "10px Syne";
      ctx.fillText("SCORE: " + score1, 10, 15);
      
      requestAnimationFrame(drawCatcher);
    }
    drawCatcher();

    function moveCatcher(dir) {
      basketX = Math.max(0, Math.min(180, basketX + dir));
    }

    // Game 2: Apo Turtle Swim Logic
    let depth = 0;
    function swimTurtle() {
      depth += 5;
      document.getElementById('turtle-score').textContent = "TURTLE DEPTH: " + depth + "m";
    }

    // Game 3: Negros Oriental Trivia Logic
    const triviaData = [
      { q: "What is Dumaguete City widely known as?", opts: ["The Land of Gentle People", "The City of Smiling Faces", "The Queen City"], ans: 0 },
      { q: "Which sanctuary in Dauin is world-famous for sea turtles?", opts: ["Pamilacan Island", "Apo Island", "Coron Island"], ans: 1 },
      { q: "Which 7km sandbar is called the 'Maldives of the Philippines'?", opts: ["Manjuyod Sandbar", "Bantayan Sandbar", "Kalanggaman Sandbar"], ans: 0 }
    ];
    let qIdx = 0;

    function nextTrivia() {
      if (qIdx >= triviaData.length) {
        document.getElementById('trivia-q').textContent = "PERFECT! YOU KNOW NEGROS ORIENTAL WELL.";
        document.getElementById('trivia-opts').innerHTML = "";
        document.getElementById('trivia-btn').style.display = 'inline-block';
        document.getElementById('trivia-btn').textContent = "RESTART";
        qIdx = 0;
        return;
      }

      document.getElementById('trivia-btn').style.display = 'none';
      const cur = triviaData[qIdx];
      document.getElementById('trivia-q').textContent = cur.q;
      
      const optsContainer = document.getElementById('trivia-opts');
      optsContainer.innerHTML = "";
      
      cur.opts.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = 'action-btn';
        btn.style.fontSize = '0.75rem';
        btn.textContent = opt;
        btn.onclick = () => {
          if (idx === cur.ans) {
            alert("Correct!");
            qIdx++;
            nextTrivia();
          } else {
            alert("Try again!");
          }
        };
        optsContainer.appendChild(btn);
      });
    }

    // Theme Toggle Logic
    function toggleTheme() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const themeBtn = document.getElementById('theme-btn');
      if (currentTheme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'light');
        themeBtn.textContent = 'Dark Mode';
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        themeBtn.textContent = 'Light Mode';
        localStorage.setItem('theme', 'dark');
      }
    }
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
    if (savedTheme === 'dark') document.getElementById('theme-btn').textContent = 'Light Mode';

    // Page Transition Animation
    document.body.classList.add('page-enter');
    document.querySelectorAll('nav a, .logo').forEach(link => {
      link.addEventListener('click', function(e) {
        const targetUrl = this.getAttribute('href');
        if (targetUrl && targetUrl !== '#' && !targetUrl.startsWith('javascript:')) {
          e.preventDefault();
          document.body.classList.remove('page-enter');
          document.body.classList.add('page-exit');
          setTimeout(() => { window.location.href = targetUrl; }, 300);
        }
      });
    });
  </script>
</body>
</html>
