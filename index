<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern UI Website</title>
    <style>
        /* Apple-style UI Reset and Typography */
        :root {
            --bg-color: #fbfbfd;
            --text-color: #1d1d1f;
            --link-color: #06c;
            --nav-bg: rgba(255, 255, 255, 0.72);
            --card-bg: #ffffff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        /* --- 1. Login Page Styling --- */
        #login-section {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-color: var(--bg-color);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            transition: opacity 0.5s ease;
        }

        .login-card {
            background: var(--card-bg);
            padding: 40px;
            border-radius: 18px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.06);
            width: 100%;
            max-width: 320px;
            text-align: center;
        }

        .login-card h2 {
            font-weight: 600;
            margin-bottom: 24px;
            font-size: 24px;
        }

        .login-card input {
            width: 100%;
            padding: 12px 16px;
            margin-bottom: 16px;
            border: 1px solid #d2d2d7;
            border-radius: 12px;
            font-size: 17px;
            outline: none;
            transition: border-color 0.2s;
        }

        .login-card input:focus {
            border-color: var(--link-color);
        }

        .login-card button {
            width: 100%;
            padding: 12px 16px;
            background-color: var(--link-color);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 17px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .login-card button:hover {
            background-color: #005bb5;
        }

        /* --- Main Website (Hidden by default until login) --- */
        #main-content {
            display: none; 
        }

        /* Frosted Glass Navigation */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            background: var(--nav-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(0,0,0,0.1);
            z-index: 100;
            display: flex;
            justify-content: center;
            padding: 14px 0;
        }

        nav a {
            color: var(--text-color);
            text-decoration: none;
            margin: 0 20px;
            font-size: 14px;
            font-weight: 400;
            letter-spacing: -0.01em;
            transition: opacity 0.2s;
        }

        nav a:hover {
            opacity: 0.6;
        }

        /* Page Sections */
        section {
            min-height: 100vh;
            padding: 100px 20px 60px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .section-title {
            font-size: 48px;
            font-weight: 600;
            letter-spacing: -0.003em;
            margin-bottom: 40px;
            text-align: center;
        }

        /* --- 2. Home Page --- */
        #home {
            justify-content: center;
            text-align: center;
        }

        #home h1 {
            font-size: 64px;
            letter-spacing: -0.015em;
            font-weight: 600;
        }

        #home p {
            font-size: 24px;
            color: #86868b;
            margin-top: 10px;
        }

        /* --- 3. Gallery (Mirroring the chalkboard drawing) --- */
        .gallery-grid {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
            width: 100%;
            max-width: 900px;
        }

        .gallery-item {
            background: #e5e5ea;
            width: 250px;
            height: 300px;
            border-radius: 18px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 50px;
            color: #86868b;
        }

        /* --- 4. About Us / The Creators --- */
        .creators-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            width: 100%;
            max-width: 900px;
        }

        .creator-card {
            background: var(--card-bg);
            padding: 30px;
            border-radius: 18px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.04);
            text-align: center;
        }

        .avatar {
            width: 80px;
            height: 80px;
            background: #e5e5ea;
            border-radius: 50%;
            margin: 0 auto 16px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 30px;
        }

        .creator-card h3 {
            font-size: 19px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .creator-card p {
            font-size: 14px;
            color: #86868b;
        }
        
        /* Smooth scrolling for anchor links */
        html {
            scroll-behavior: smooth;
        }
    </style>
</head>
<body>

    <!-- 1) LOGIN PAGE -->
    <div id="login-section">
        <div class="login-card">
            <h2>Sign In</h2>
            <input type="text" placeholder="Username" id="username">
            <input type="password" placeholder="Password" id="password">
            <button onclick="handleLogin()">Log In</button>
        </div>
    </div>

    <!-- MAIN WEBSITE (Home, Gallery, About Us) -->
    <div id="main-content">
        
        <!-- Navigation Bar -->
        <nav>
            <a href="#home">Home</a>
            <a href="#gallery">Gallery</a>
            <a href="#about">About Us</a>
        </nav>

        <!-- 2) HOME PAGE -->
        <section id="home">
            <h1>Welcome.</h1>
            <p>Pro design. Right in your browser.</p>
        </section>

        <!-- 3) GALLERY -->
        <section id="gallery">
            <h2 class="section-title">Gallery</h2>
            <div class="gallery-grid">
                <!-- Placeholder images mimicking the stick figures from the chalkboard -->
                <div class="gallery-item">🖼️</div>
                <div class="gallery-item">🖼️</div>
                <div class="gallery-item">🖼️</div>
            </div>
        </section>

        <!-- 4) ABOUT US / THE CREATORS -->
        <section id="about">
            <h2 class="section-title">The Creators</h2>
            <div class="creators-grid">
                <!-- Creator 1 -->
                <div class="creator-card">
                    <div class="avatar">👨‍💻</div>
                    <h3>Creator One</h3>
                    <p>Lead Designer</p>
                </div>
                <!-- Creator 2 -->
                <div class="creator-card">
                    <div class="avatar">👩‍💻</div>
                    <h3>Creator Two</h3>
                    <p>HTML Student</p>
                </div>
                <!-- Creator 3 -->
                <div class="creator-card">
                    <div class="avatar">👨‍🎨</div>
                    <h3>Creator Three</h3>
                    <p>Visionary</p>
                </div>
            </div>
        </section>

    </div>

    <!-- JavaScript to handle the login transition -->
    <script>
        function handleLogin() {
            // Fade out the login screen
            const loginSection = document.getElementById('login-section');
            loginSection.style.opacity = '0';
            
            // Wait for the fade out to finish (0.5s), then hide it and show main content
            setTimeout(() => {
                loginSection.style.display = 'none';
                document.getElementById('main-content').style.display = 'block';
                // Scroll to top just in case
                window.scrollTo(0, 0);
            }, 500);
        }
    </script>

</body>
</html>
