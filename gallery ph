<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WANDERLUST — Philippines Gallery</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Syne:wght@700;800&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-color: #ffffff;
      --text-color: #000000;
      --border-color: #000000;
      --card-bg: #f8f8f8;
      --accent-hover: #000000;
      --accent-text-hover: #ffffff;
    }

    [data-theme="dark"] {
      --bg-color: #0a0a0a;
      --text-color: #ffffff;
      --border-color: #ffffff;
      --card-bg: #141414;
      --accent-hover: #ffffff;
      --accent-text-hover: #000000;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-color);
      color: var(--text-color);
      font-family: 'Inter', sans-serif;
      transition: background-color 0.3s ease, color 0.3s ease, filter 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
    }

    body.page-exit {
      filter: blur(12px) brightness(1.1);
      transform: scale(0.98);
      opacity: 0;
    }

    body.page-enter {
      animation: motionBlurIn 0.4s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }

    @keyframes motionBlurIn {
      0% { filter: blur(15px); transform: scale(1.02); opacity: 0; }
      100% { filter: blur(0px); transform: scale(1); opacity: 1; }
    }

    header {
      width: 100%;
      padding: 25px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--border-color);
    }

    .logo {
      font-family: 'Playfair Display', serif;
      font-size: 2.2rem;
      font-weight: 900;
      text-transform: uppercase;
      color: var(--text-color);
      text-decoration: none;
    }

    nav { display: flex; align-items: center; gap: 20px; }

    .nav-btn {
      text-decoration: none;
      color: var(--text-color);
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      padding: 8px 16px;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }

    .nav-btn:hover, .nav-btn.active {
      border-color: var(--border-color);
      background: var(--accent-hover);
      color: var(--accent-text-hover);
    }

    .theme-toggle-btn {
      background: none;
      border: 1px solid var(--border-color);
      color: var(--text-color);
      padding: 8px 16px;
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 0.8rem;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .theme-toggle-btn:hover {
      background: var(--accent-hover);
      color: var(--accent-text-hover);
    }

    main {
      flex: 1;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      padding: 50px 20px;
    }

    .gallery-header {
      text-align: center;
      border-bottom: 2px solid var(--border-color);
      padding-bottom: 30px;
      margin-bottom: 40px;
    }

    .gallery-header h1 {
      font-family: 'Playfair Display', serif;
      font-size: 3.5rem;
      font-weight: 900;
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .gallery-header p {
      font-family: 'Syne', sans-serif;
      font-size: 0.9rem;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* Custom Image Upload Form */
    .upload-section {
      background: var(--card-bg);
      border: 2px solid var(--border-color);
      padding: 25px;
      margin-bottom: 40px;
      box-shadow: 6px 6px 0px var(--border-color);
      display: flex;
      flex-direction: column;
      gap: 15px;
      align-items: center;
    }

    .upload-inputs {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      width: 100%;
      justify-content: center;
    }

    .upload-inputs input[type="text"],
    .upload-inputs input[type="file"] {
      padding: 10px;
      background: var(--bg-color);
      border: 2px solid var(--border-color);
      color: var(--text-color);
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
    }

    .upload-btn {
      background: var(--bg-color);
      border: 2px solid var(--border-color);
      color: var(--text-color);
      padding: 12px 24px;
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 0.85rem;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .upload-btn:hover {
      background: var(--accent-hover);
      color: var(--accent-text-hover);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 30px;
    }

    .card {
      background: var(--card-bg);
      border: 2px solid var(--border-color);
      box-shadow: 6px 6px 0px var(--border-color);
      filter: grayscale(100%);
      transition: filter 0.3s ease, transform 0.3s ease;
    }

    .card:hover {
      filter: grayscale(0%);
      transform: translateY(-4px);
    }

    .card img {
      width: 100%;
      height: 240px;
      object-fit: cover;
      border-bottom: 2px solid var(--border-color);
    }

    .card-info {
      padding: 20px;
    }

    .card-info h3 {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      font-weight: 900;
      margin-bottom: 8px;
      text-transform: uppercase;
    }

    .card-info p {
      font-size: 0.95rem;
      line-height: 1.4;
      opacity: 0.8;
    }

    @media (max-width: 768px) {
      header { flex-direction: column; gap: 15px; padding: 20px; }
      .gallery-header h1 { font-size: 2.5rem; }
      .upload-inputs { flex-direction: column; }
    }
  </style>
</head>
<body>

  <header>
    <a href="index.html" class="logo">Wanderlust</a>
    <nav>
      <a href="index.html" class="nav-btn">Home</a>
      <a href="gallery.html" class="nav-btn active">Gallery</a>
      <a href="about.html" class="nav-btn">About Us</a>
      <a href="login.html" class="nav-btn">Login</a>
      <button class="theme-toggle-btn" id="theme-btn" onclick="toggleTheme()">Dark Mode</button>
    </nav>
  </header>

  <main>
    <div class="gallery-header">
      <h1>Philippine Wonders</h1>
      <p>ARCHIPELAGO EDITION — 7,641 ISLANDS</p>
    </div>

    <!-- Image Upload Area -->
    <div class="upload-section">
      <div class="upload-inputs">
        <input type="file" id="image-file" accept="image/*">
        <input type="text" id="image-title" placeholder="Location Name (e.g., Siargao)">
        <input type="text" id="image-desc" placeholder="Description (e.g., Cloud 9 Surfing)">
      </div>
      <button class="upload-btn" onclick="addCustomImage()">Add To Gallery</button>
    </div>

    <!-- Philippine Destinations Grid -->
    <div class="grid" id="gallery-grid">
      <div class="card">
        <img src="https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?auto=format&fit=crop&w=800&q=80" alt="El Nido Palawan" />
        <div class="card-info">
          <h3>El Nido, Palawan</h3>
          <p>Dramatic limestone cliffs surrounded by crystal-clear turquoise lagoons.</p>
        </div>
      </div>

      <div class="card">
        <img src="https://images.unsplash.com/photo-1540202404-a2f29016b523?auto=format&fit=crop&w=800&q=80" alt="Banaue Rice Terraces" />
        <div class="card-info">
          <h3>Banaue, Ifugao</h3>
          <p>Ancient 2,000-year-old rice terraces hand-carved into the mountains.</p>
        </div>
      </div>

      <div class="card">
        <img src="https://images.unsplash.com/photo-1583253633288-29ef31010332?auto=format&fit=crop&w=800&q=80" alt="Chocolate Hills Bohol" />
        <div class="card-info">
          <h3>Chocolate Hills, Bohol</h3>
          <p>Over 1,200 symmetrical geological mound formations across the island landscape.</p>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Custom Image Upload Functionality
    function addCustomImage() {
      const fileInput = document.getElementById('image-file');
      const titleInput = document.getElementById('image-title').value.trim();
      const descInput = document.getElementById('image-desc').value.trim();
      const grid = document.getElementById('gallery-grid');

      if (!fileInput.files || !fileInput.files[0]) {
        alert("Please select an image file first.");
        return;
      }

      const file = fileInput.files[0];
      const reader = new FileReader();

      reader.onload = function(e) {
        const card = document.createElement('div');
        card.className = 'card';
        card.innerHTML = `
          <img src="${e.target.result}" alt="${titleInput || 'Philippine Destination'}" />
          <div class="card-info">
            <h3>${titleInput || 'Untitled Local Gem'}</h3>
            <p>${descInput || 'User uploaded Philippine destination.'}</p>
          </div>
        `;
        grid.prepend(card);

        // Clear input fields
        fileInput.value = '';
        document.getElementById('image-title').value = '';
        document.getElementById('image-desc').value = '';
      };

      reader.readAsDataURL(file);
    }

    // Theme Toggle Logic
    function toggleTheme() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const themeBtn = document.getElementById('theme-btn');
      if (currentTheme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'light');
        themeBtn.textContent = 'Dark Mode';
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        themeBtn.textContent = 'Light Mode';
        localStorage.setItem('theme', 'dark');
      }
    }
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
    if (savedTheme === 'dark') document.getElementById('theme-btn').textContent = 'Light Mode';

    // Page Transition Animation
    document.body.classList.add('page-enter');
    document.querySelectorAll('nav a, .logo').forEach(link => {
      link.addEventListener('click', function(e) {
        const targetUrl = this.getAttribute('href');
        if (targetUrl && targetUrl !== '#' && !targetUrl.startsWith('javascript:')) {
          e.preventDefault();
          document.body.classList.remove('page-enter');
          document.body.classList.add('page-exit');
          setTimeout(() => { window.location.href = targetUrl; }, 300);
        }
      });
    });
  </script>
</body>
</html>
