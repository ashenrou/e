/* Motion blur transition classes */
body {
  transition: filter 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
}

body.page-exit {
  filter: blur(12px) brightness(1.2);
  transform: scale(0.98);
  opacity: 0;
}

body.page-enter {
  animation: motionBlurIn 0.4s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

@keyframes motionBlurIn {
  0% {
    filter: blur(15px);
    transform: scale(1.03);
    opacity: 0;
  }
  100% {
    filter: blur(0px);
    transform: scale(1);
    opacity: 1;
  }
}
